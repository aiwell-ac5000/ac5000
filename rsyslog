/var/log/syslog
{
        rotate 0
        maxsize 40M
        hourly
        missingok
        notifempty
        sharedscripts
        postrotate
                /usr/bin/systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
        endscript
}
